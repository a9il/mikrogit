{
  "name": "mikrogit",
  "version": "0.1.0",
  "description": "Native cross-platform Git client with VS Code-like Source Control — no Electron. Built with Tauri v2 (Rust + OS WebView) for fast startup, low RAM, and small binaries.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "verify": "bash verify.sh",
    "verify:fast": "bash verify.sh --fast",
    "verify:watch": "bash verify.sh --watch",
    "verify:build": "bash verify.sh --build",
    "verify:e2e": "bash verify.sh",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@vitest/coverage-v8": "^5.0.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0",
    "webdriverio": "^9.31.7"
  }
}
